<Window x:Class="TyPoTaKer.Desktop.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypoFormer — QuillBot-Style Grammar Assistant"
        Height="640" Width="980"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        Foreground="#0F172A"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Custom ScrollBar Styling -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="6" />
        </Style>

        <!-- QuillBot Green Pill Button Style -->
        <Style x:Key="QuillBotAcceptButton" TargetType="Button">
            <Setter Property="Background" Value="#15803D" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#166534" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#14532D" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- QuillBot Ignore Button Style -->
        <Style x:Key="QuillBotIgnoreButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Top Navigation & Header Bar -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="20,0,20,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#10B981" CornerRadius="8" Padding="9,3.5" Margin="0,0,10,0">
                        <TextBlock Text="TYPOFORMER" FontWeight="Bold" FontSize="11.5" Foreground="#FFFFFF" />
                    </Border>
                    <TextBlock Text="Grammar Assistant" FontSize="16" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />
                    <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Stage 2 v4 (94M INT8) · Offline" FontSize="11" FontWeight="SemiBold" Foreground="#475569" />
                    </Border>
                </StackPanel>

                <!-- Right Quick Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="TabAcceptCheckBox" Content="Tab Accept" IsChecked="True" FontSize="12" Foreground="#475569" Margin="0,0,16,0" VerticalAlignment="Center" Click="OnTabAcceptChanged" />
                    <Button x:Name="ClearButton" Content="Clear" Background="Transparent" Foreground="#64748B" FontSize="12" BorderThickness="0" Cursor="Hand" Margin="0,0,16,0" Click="OnClearPlaygroundClick" />
                    <Button x:Name="MinimizeBtn" Content="Minimize to Tray" Background="#F1F5F9" Foreground="#334155" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10,4" FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Click="OnMinimizeClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Workspace: QuillBot Editor Canvas + Grammar Assistant Sidebar -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: QuillBot Editor Canvas with Gutter and Floating Pill -->
            <Grid Grid.Column="0" Background="#FFFFFF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Gutter: Vertical Guide Line + Error Count Pill (from Screenshot 2) -->
                <Grid Grid.Column="0">
                    <!-- Vertical thin guideline -->
                    <Border Width="1.2" Background="#E2E8F0" HorizontalAlignment="Center" />

                    <!-- Circular error count badge on the guideline -->
                    <Border x:Name="GutterBadge"
                            Width="30"
                            Height="44"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Margin="0,32,0,0"
                            CornerRadius="15">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.12" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22" />
                                <RowDefinition Height="22" />
                            </Grid.RowDefinitions>

                            <!-- Top: Red Pill with error count -->
                            <Border Grid.Row="0" Background="#E11D48" CornerRadius="15,15,0,0">
                                <TextBlock x:Name="GutterCountText" Text="3" FontSize="11.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <!-- Bottom: White Pill with QuillBot Head Icon -->
                            <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1" CornerRadius="0,0,15,15">
                                <TextBlock Text="☖" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Writing Area: RichTextBox Canvas -->
                <Grid Grid.Column="1">
                    <RichTextBox x:Name="PlaygroundRichTextBox"
                                 Background="#FFFFFF"
                                 Foreground="#0F172A"
                                 CaretBrush="#0F172A"
                                 BorderThickness="0"
                                 Padding="24,32,28,80"
                                 FontSize="16.5"
                                 FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 TextChanged="OnPlaygroundTextChanged"
                                 SelectionChanged="OnPlaygroundSelectionChanged"
                                 PreviewKeyDown="OnPlaygroundPreviewKeyDown">
                        <FlowDocument LineHeight="28">
                            <Paragraph Margin="0">
                                <Run Text="this should take place in a very new way. but the thing si to make it happen." />
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>

                    <!-- Floating Pill Widget at Bottom-Right of Editor: "Fix 3 errors [tab] ▾" (from Screenshot 2) -->
                    <Border x:Name="FloatingFixPill"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Margin="0,0,28,24"
                            Background="#FFFFFF"
                            BorderBrush="#CBD5E1"
                            BorderThickness="1.2"
                            CornerRadius="20"
                            Padding="14,7"
                            Cursor="Hand"
                            MouseLeftButtonDown="OnFloatingFixPillClick">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.10" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Icon: Red squiggly 'A' -->
                            <TextBlock Text="A" FontSize="13.5" FontWeight="Bold" Foreground="#DC2626" TextDecorations="Underline" Margin="0,0,8,0" />

                            <!-- Text: "Fix 3 errors" -->
                            <TextBlock x:Name="FloatingFixText" Text="Fix 3 errors" FontSize="13" FontWeight="SemiBold" Foreground="#0F172A" VerticalAlignment="Center" />

                            <!-- Shortcut tag: "tab" -->
                            <Border Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="5,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="tab" FontSize="10.5" FontWeight="SemiBold" Foreground="#64748B" />
                            </Border>

                            <!-- Dropdown arrow: "▾" -->
                            <TextBlock Text="▾" FontSize="11" Foreground="#64748B" Margin="6,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Column 1: Grammar Assistant Sidebar Panel (from Screenshot 1) -->
            <Border x:Name="SidebarBorder" Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50" />
                        <RowDefinition Height="46" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 1. Sidebar Header: Icon + "Grammar Assistant" + Language Dropdown + Close Button (Screenshot 1) -->
                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,0,14,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Lavender Badge with Checkmark -->
                            <Border Grid.Column="0" Width="26" Height="26" Background="#EDE9FE" CornerRadius="13" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="#7C3AED" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <TextBlock Grid.Column="1" Text="Grammar Assistant" FontSize="14.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />

                            <!-- Language Selector -->
                            <TextBlock Grid.Column="2" Text="English (US) ▾" FontSize="12.5" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,12,0" />

                            <!-- Close / Dismiss Button -->
                            <Button x:Name="CloseSidebarBtn" Grid.Column="3" Content="✕" Width="22" Height="22" Background="Transparent" Foreground="#64748B" BorderThickness="0" Cursor="Hand" Click="OnCloseSidebarClick" ToolTip="Collapse Assistant" />
                        </Grid>
                    </Border>

                    <!-- 2. Sub-Tabs: All [3] | Grammar [3] | Recommendations (Screenshot 1) -->
                    <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="14,0,14,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Tab 1: All [3] with dark green active underline indicator -->
                            <Grid Grid.Column="0" VerticalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,2">
                                    <TextBlock Text="All" FontSize="13" FontWeight="Bold" Foreground="#15803D" VerticalAlignment="Center" />
                                    <Border x:Name="AllCountBadge" Background="#0F172A" CornerRadius="9" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="AllCountText" Text="3" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </Border>
                                </StackPanel>
                                <Border Height="2.5" Background="#15803D" VerticalAlignment="Bottom" />
                            </Grid>

                            <!-- Tab 2: Grammar [3] -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Grammar" FontSize="13" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" />
                                <Border x:Name="GrammarCountBadge" Background="#FFE4E6" CornerRadius="9" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="GrammarCountText" Text="3" FontSize="11" FontWeight="Bold" Foreground="#E11D48" />
                                </Border>
                            </StackPanel>

                            <!-- Tab 3: Recommendations -->
                            <TextBlock Grid.Column="4" Text="Recommendations" FontSize="12.5" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center" HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- 3. Error Cards Scrollable List (Screenshot 1) -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="16,16,16,16">
                        <StackPanel>
                            <!-- Error Cards dynamically populated here -->
                            <StackPanel x:Name="ErrorCardsContainer" />

                            <!-- Clean Empty State (visible when 0 errors) -->
                            <Border x:Name="EmptyStatePanel" Visibility="Collapsed" Padding="20,40" HorizontalAlignment="Center">
                                <StackPanel HorizontalAlignment="Center">
                                    <Border Width="48" Height="48" Background="#DCFCE7" CornerRadius="24" HorizontalAlignment="Center" Margin="0,0,0,12">
                                        <TextBlock Text="✓" FontSize="24" FontWeight="Bold" Foreground="#15803D" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="No grammar issues found" FontSize="15" FontWeight="Bold" Foreground="#0F172A" HorizontalAlignment="Center" />
                                    <TextBlock Text="Your writing is clear and polished." FontSize="12.5" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Bottom Status Bar -->
        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,6">
            <Grid>
                <TextBlock x:Name="StatusStripText" Text="TypoFormer active · Offline neural GEC running on local CPU" FontSize="11.5" Foreground="#64748B" VerticalAlignment="Center" />
                <TextBlock Text="Press Tab to quickly accept the highlighted suggestion." FontSize="11.5" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
