<Window x:Class="TyPoTaKer.Desktop.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypoFormer — AI Typing Companion"
        Height="620" Width="820"
        MinHeight="580" MinWidth="740"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Custom ScrollBar Styling -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
        </Style>

        <!-- Modern Toggle Switch Style -->
        <Style x:Key="ModernToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#10B981" CornerRadius="8" Padding="10,4" Margin="0,0,12,0">
                        <TextBlock Text="TYPOFORMER" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                    </Border>
                    <TextBlock Text="AI Desktop Companion" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Local, zero-latency 94M parameter causal LM &amp; GEC running entirely offline on your PC" 
                           Foreground="#94A3B8" FontSize="12.5" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Status Indicator Pill -->
            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1.2" CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#10B981" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="Active &amp; Listening" FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Model Diagnostics Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: LM Status -->
            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="16,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Language Model" FontSize="12.5" FontWeight="Bold" Foreground="#818CF8" />
                    </StackPanel>
                    <TextBlock x:Name="LmModelNameText" Text="Stage 2 v4 (94M INT8)" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="7.2 ms CPU latency · Autocomplete" FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 2: GEC Status -->
            <Border Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="16,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Grammar &amp; Typo Engine" FontSize="12.5" FontWeight="Bold" Foreground="#34D399" />
                    </StackPanel>
                    <TextBlock x:Name="GecModelNameText" Text="Stage 2 v4 (94M INT8)" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="100% clean retention · 0 false edits" FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 3: Memory & Runtime -->
            <Border Grid.Column="4" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="16,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="Vocabulary &amp; Maps" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" />
                    </StackPanel>
                    <TextBlock Text="16,000 Vocab / 6,144 Edits" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="v4 Multi-domain paired lexicon" FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Interactive Live Typing Playground (Grammarly Experience) -->
        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="14" Padding="20,18" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Grammarly-Style Typing Editor" FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC" />
                            <Border Background="#3B82F6" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
                                <TextBlock Text="Live Grammar &amp; Spell Check" FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Mistakes are highlighted in red. Move your cursor over any red text to inspect and apply suggestions at that exact position." 
                                   FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Error Counter Pill -->
                    <Border x:Name="ErrorCounterBadge" 
                            Background="#7F1D1D" 
                            BorderBrush="#EF4444" 
                            BorderThickness="1" 
                            CornerRadius="12" 
                            Padding="10,3" 
                            HorizontalAlignment="Right" 
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ErrorCounterText" Text="0 suggestions" FontSize="11.5" FontWeight="Bold" Foreground="#FCA5A5" />
                    </Border>
                </Grid>

                <!-- Interactive RichTextBox with Grammarly Highlighting -->
                <RichTextBox x:Name="PlaygroundRichTextBox"
                             Grid.Row="1"
                             Background="#0F172A"
                             Foreground="#F8FAFC"
                             CaretBrush="#818CF8"
                             BorderBrush="#334155"
                             BorderThickness="1.2"
                             FontSize="14.5"
                             FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                             Padding="14"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextChanged="OnPlaygroundTextChanged"
                             SelectionChanged="OnPlaygroundSelectionChanged"
                             PreviewMouseMove="OnPlaygroundMouseMove"
                             PreviewKeyDown="OnPlaygroundPreviewKeyDown">
                    <FlowDocument LineHeight="24">
                        <Paragraph Margin="0">
                            <Run Text="Modern bussiness adopt technolagy to increase efficency. The list of requirements were updated by the committee." />
                        </Paragraph>
                    </FlowDocument>
                </RichTextBox>

                <!-- Floating Grammarly Suggestion Card -->
                <Popup x:Name="GrammarlyPopup"
                       Placement="Relative"
                       PlacementTarget="{Binding ElementName=PlaygroundRichTextBox}"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       StaysOpen="True">
                    <Border Background="#1E293B"
                            BorderBrush="#475569"
                            BorderThickness="1.4"
                            CornerRadius="12"
                            Padding="16,12"
                            MinWidth="260"
                            MaxWidth="400">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="4" Opacity="0.75" />
                        </Border.Effect>
                        <StackPanel Orientation="Vertical">
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="CardCategoryBadge" Background="#7F1D1D" CornerRadius="6" Padding="7,2.5" Margin="0,0,8,0">
                                        <TextBlock x:Name="CardCategoryText" Text="SPELLING" FontSize="10.5" FontWeight="Bold" Foreground="#FCA5A5" />
                                    </Border>
                                    <TextBlock Text="Suggested Fix" FontSize="12" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button x:Name="DismissCardBtn" Content="✕" Width="22" Height="22" HorizontalAlignment="Right" Foreground="#64748B" BorderThickness="0" Cursor="Hand" Click="OnDismissCardClick" ToolTip="Ignore suggestion">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#334155" />
                                                    <Setter Property="Foreground" Value="#F8FAFC" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock x:Name="CardOriginalText" Grid.Column="0" Text="bussiness" TextDecorations="Strikethrough" Foreground="#EF4444" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="→" Foreground="#64748B" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button x:Name="CardApplyButton"
                                        Grid.Column="2"
                                        HorizontalAlignment="Left"
                                        Foreground="#FFFFFF"
                                        FontWeight="Bold"
                                        FontSize="13"
                                        Padding="14,6"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="OnCardApplyClick">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="#10B981" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#059669" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#047857" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <TextBlock x:Name="CardReplacementText" Text="businesses" />
                                </Button>
                            </Grid>

                            <TextBlock Text="Click green button or press Enter to replace only at this position." FontSize="11" Foreground="#64748B" />
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Status strip below sandbox -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock x:Name="PlaygroundStatusText" 
                               Text="TypoFormer active: errors are underlined in red. Cursor over words to review and apply single-word fixes." 
                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                    <Button x:Name="ClearPlaygroundButton"
                            Content="Clear Sandbox"
                            HorizontalAlignment="Right"
                            Foreground="#E2E8F0"
                            BorderThickness="0"
                            Padding="12,4"
                            FontSize="11.5"
                            Cursor="Hand"
                            Click="OnClearPlaygroundClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="#334155" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#475569" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <!-- 4. Footer Settings & Action Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Toggles -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="StartupCheckBox" 
                          Content="Start with Windows" 
                          Style="{StaticResource ModernToggle}" 
                          Margin="0,0,20,0" 
                          Checked="OnStartupChecked" 
                          Unchecked="OnStartupUnchecked" />

                <CheckBox x:Name="TabAcceptCheckBox" 
                          Content="Accept with Tab" 
                          Style="{StaticResource ModernToggle}" 
                          IsChecked="True" 
                          Margin="0,0,20,0" 
                          Checked="OnTabAcceptChanged" 
                          Unchecked="OnTabAcceptChanged" />
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ResetBufferButton"
                        Content="Reset Buffer"
                        Background="#334155"
                        Foreground="#E2E8F0"
                        BorderThickness="0"
                        Padding="14,7"
                        Margin="0,0,10,0"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="OnResetBufferClick" />

                <Button x:Name="MinimizeButton"
                        Content="Minimize to Tray"
                        Background="#4F46E5"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Padding="16,7"
                        FontSize="12.5"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="OnMinimizeClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
