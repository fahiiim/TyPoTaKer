<Window x:Class="TyPoTaKer.Desktop.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TypoFormer — AI Typing Companion"
        Height="620" Width="820"
        MinHeight="580" MinWidth="740"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">

    <Window.Resources>
        <!-- Custom ScrollBar Styling -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="8" />
        </Style>

        <!-- Modern Toggle Switch Style -->
        <Style x:Key="ModernToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#10B981" CornerRadius="8" Padding="10,4" Margin="0,0,12,0">
                        <TextBlock Text="⚡ TYPOFORMER" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                    </Border>
                    <TextBlock Text="AI Desktop Companion" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Local, zero-latency 94M parameter causal LM &amp; GEC running entirely offline on your PC" 
                           Foreground="#94A3B8" FontSize="12.5" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Status Indicator Pill -->
            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1.2" CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#10B981" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="Active &amp; Listening" FontSize="12.5" FontWeight="SemiBold" Foreground="#E2E8F0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Model Diagnostics Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: LM Status -->
            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="16,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="✨" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Language Model" FontSize="12.5" FontWeight="Bold" Foreground="#818CF8" />
                    </StackPanel>
                    <TextBlock x:Name="LmModelNameText" Text="Stage 2 v4 (94M INT8)" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="7.2 ms CPU latency · Autocomplete" FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 2: GEC Status -->
            <Border Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="16,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="🛡️" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Grammar &amp; Typo Engine" FontSize="12.5" FontWeight="Bold" Foreground="#34D399" />
                    </StackPanel>
                    <TextBlock x:Name="GecModelNameText" Text="Stage 2 v4 (94M INT8)" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="100% clean retention · 0 false edits" FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Card 3: Memory & Runtime -->
            <Border Grid.Column="4" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="16,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="⚡" FontSize="14" Margin="0,0,6,0" />
                        <TextBlock Text="Vocabulary &amp; Maps" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8" />
                    </StackPanel>
                    <TextBlock Text="16,000 Vocab / 6,144 Edits" FontSize="15" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="v4 Multi-domain paired lexicon" FontSize="11.5" Foreground="#94A3B8" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. Interactive Live Typing Playground -->
        <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="14" Padding="20,18" Margin="0,0,0,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Live Typing Sandbox" FontSize="14.5" FontWeight="Bold" Foreground="#F8FAFC" />
                    <TextBlock Text="Type below to see live autocomplete suggestions (Tab / Ctrl+Space) and automatic grammar fixes." 
                               FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Interactive TextBox -->
                <TextBox x:Name="PlaygroundTextBox"
                         Grid.Row="1"
                         Background="#0F172A"
                         Foreground="#F8FAFC"
                         CaretBrush="#818CF8"
                         BorderBrush="#334155"
                         BorderThickness="1.2"
                         FontSize="14"
                         FontFamily="Cascadia Code, Consolas, Segoe UI"
                         Padding="12"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Text="Could you please review the configuration file before the meeting starts?&#x0a;This is teh " />

                <!-- Status strip below sandbox -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock x:Name="PlaygroundStatusText" 
                               Text="💡 Tip: Press Tab or Ctrl+Space when the floating pill appears to apply suggestions instantly." 
                               FontSize="12" Foreground="#64748B" VerticalAlignment="Center" />
                    <Button x:Name="ClearPlaygroundButton"
                            Content="Clear Sandbox"
                            HorizontalAlignment="Right"
                            Background="#334155"
                            Foreground="#E2E8F0"
                            BorderThickness="0"
                            Padding="12,4"
                            FontSize="11.5"
                            Cursor="Hand"
                            Click="OnClearPlaygroundClick" />
                </Grid>
            </Grid>
        </Border>

        <!-- 4. Footer Settings & Action Buttons -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Toggles -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox x:Name="StartupCheckBox" 
                          Content="Start with Windows" 
                          Style="{StaticResource ModernToggle}" 
                          Margin="0,0,20,0" 
                          Checked="OnStartupChecked" 
                          Unchecked="OnStartupUnchecked" />

                <CheckBox x:Name="TabAcceptCheckBox" 
                          Content="Accept with Tab" 
                          Style="{StaticResource ModernToggle}" 
                          IsChecked="True" 
                          Margin="0,0,20,0" 
                          Checked="OnTabAcceptChanged" 
                          Unchecked="OnTabAcceptChanged" />
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ResetBufferButton"
                        Content="Reset Buffer"
                        Background="#334155"
                        Foreground="#E2E8F0"
                        BorderThickness="0"
                        Padding="14,7"
                        Margin="0,0,10,0"
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        Click="OnResetBufferClick" />

                <Button x:Name="MinimizeButton"
                        Content="Minimize to Tray"
                        Background="#4F46E5"
                        Foreground="#FFFFFF"
                        BorderThickness="0"
                        Padding="16,7"
                        FontSize="12.5"
                        FontWeight="Bold"
                        Cursor="Hand"
                        Click="OnMinimizeClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
