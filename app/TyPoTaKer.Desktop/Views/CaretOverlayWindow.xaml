<Window x:Class="TyPoTaKer.Desktop.Views.CaretOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TyPoTaKer Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Deep Soft Glow Shadow -->
        <DropShadowEffect x:Key="GlowShadow"
                          Color="#000000"
                          BlurRadius="24"
                          ShadowDepth="5"
                          Opacity="0.65" />
    </Window.Resources>

    <Grid Margin="16" x:Name="RootContainer" Opacity="0">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="OverlayScale" ScaleX="0.95" ScaleY="0.95" />
                <TranslateTransform x:Name="OverlayTranslate" Y="4" />
            </TransformGroup>
        </Grid.RenderTransform>

        <Border x:Name="PillBorder"
                Background="#F00F172A"
                BorderBrush="#6366F1"
                BorderThickness="1.4"
                CornerRadius="10"
                Effect="{StaticResource GlowShadow}"
                Padding="10,6,12,6">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Clickable Suggestion Area -->
                <StackPanel x:Name="ContentArea"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            ToolTip="Click or press Tab / Ctrl+Space to apply"
                            MouseLeftButtonDown="OnContentClick">

                    <!-- Brand Fountain Pen Icon -->
                    <Image Source="typoformer.ico" Width="17" Height="17" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />

                    <!-- Badge (Fix vs Next vs Clean) -->
                    <Border x:Name="ModeBadge"
                            CornerRadius="6"
                            Padding="7,2.5"
                            Margin="0,0,9,0"
                            Background="#6366F1">
                        <TextBlock x:Name="ModeText"
                                   Text="NEXT"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF" />
                    </Border>

                    <!-- Text Content Display -->
                    <TextBlock x:Name="SuggestionText"
                               Text="suggestion"
                               FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#F8FAFC"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />

                    <!-- Hotkey Acceptance Badge -->
                    <Border x:Name="HotkeyBadge"
                            Background="#1E293B"
                            BorderBrush="#475569"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="6,2"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="HotkeyText"
                                   Text="Tab"
                                   FontFamily="Segoe UI Variable Small, Consolas, Segoe UI"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Foreground="#CBD5E1" />
                    </Border>
                </StackPanel>

                <!-- Dismiss Button (Esc) -->
                <Border x:Name="DismissButton"
                        Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="6,2"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        ToolTip="Dismiss (Esc)"
                        MouseLeftButtonDown="OnDismissClick">
                    <TextBlock Text="Esc"
                               FontFamily="Segoe UI Variable Small, Consolas, Segoe UI"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#94A3B8"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
