<Window x:Class="TyPoTaKer.Desktop.Views.CaretOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TyPoTaKer Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Dropshadow effect -->
        <DropShadowEffect x:Key="GlowShadow"
                          Color="#000000"
                          BlurRadius="18"
                          ShadowDepth="4"
                          Opacity="0.55" />
    </Window.Resources>

    <Grid Margin="12">
        <Border x:Name="PillBorder"
                Background="#EE111622"
                BorderBrush="#38BDF8"
                BorderThickness="1.2"
                CornerRadius="9"
                Effect="{StaticResource GlowShadow}"
                Padding="10,6,12,6">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Badge (Mode Indicator) -->
                <Border x:Name="ModeBadge"
                        CornerRadius="5"
                        Padding="6,2"
                        Margin="0,0,8,0"
                        Background="#6366F1">
                    <TextBlock x:Name="ModeText"
                               Text="✨ NEXT"
                               FontFamily="Segoe UI"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Foreground="#FFFFFF" />
                </Border>

                <!-- Text Content Display -->
                <TextBlock x:Name="SuggestionText"
                           Text="suggestion"
                           FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                           FontSize="13.5"
                           FontWeight="Medium"
                           Foreground="#F8FAFC"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0" />

                <!-- Hotkey acceptance hint pill -->
                <Border Background="#1E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="5,1"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="Ctrl + Space"
                               FontFamily="Consolas, Segoe UI"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="#94A3B8" />
                </Border>

                <!-- Dismiss Button (✕) -->
                <Border x:Name="DismissButton"
                        Background="#261E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="5,1"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        ToolTip="Dismiss suggestion (Esc)"
                        MouseLeftButtonDown="OnDismissClick">
                    <TextBlock Text="✕ Esc"
                               FontFamily="Consolas, Segoe UI"
                               FontSize="9.5"
                               FontWeight="Bold"
                               Foreground="#64748B"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
